# Banco MongoDB. Use credenciais exclusivas e TLS em produção. mongodb+srv://
# habilita TLS por padrão; com mongodb:// declare ?tls=true (ou ?ssl=true).
# Pooling: dimensione o pool na própria connection string (o driver do MongoDB
# gerencia o pool; o PrismaClient é singleton por processo). Em produção com
# várias instâncias, ajuste maxPoolSize por instância para não estourar o limite
# de conexões do cluster (conexões ~= instâncias x maxPoolSize). Ex.:
# mongodb+srv://user:pass@cluster/biblion?retryWrites=true&w=majority&maxPoolSize=10&minPoolSize=0&maxIdleTimeMS=60000
DATABASE_URL="mongodb://127.0.0.1:27017/biblion"

# URL pública incorporada no build. Produção deve usar HTTPS e não ter caminho.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ALLOWED_ORIGINS=""
# Desenvolvimento local: false. Produção: true somente atrás de proxy confiável
# que bloqueie acesso direto e saneie x-forwarded-for/host/proto.
TRUST_PROXY="false"

# Selecione explicitamente um provedor. Preencha somente chaves no ambiente real.
AI_PROVIDER="gemini"
GOOGLE_GENERATIVE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Obrigatório em produção. Usado para rate limit,
# anti-brute-force E o fan-out em tempo real (pub/sub) que alimenta o stream SSE
# /api/stream. Sem Redis, o SSE funciona via EventEmitter em processo (ok para
# instância única) e o client mantém o polling como fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Segurança (opcionais):
# - PASSWORD_HIBP_CHECK: "true" verifica senhas novas no Have I Been Pwned via
#   k-anonymity (só o prefixo do SHA-1 é enviado). Fail-open: se o HIBP estiver
#   indisponível, a senha não é bloqueada. A blocklist local é sempre ativa.
# - CSP_REPORT_ONLY: "true" publica a CSP em modo Report-Only (monitora sem
#   bloquear) para rollout; padrão (vazio/false) é enforce. Violações vão para
#   /api/csp-report em ambos os modos.
PASSWORD_HIBP_CHECK="false"
CSP_REPORT_ONLY="false"

# Segredo dos jobs internos (cron de manutenção, processamento do outbox).
# Obrigatório para as rotas /api/internal/* funcionarem (fail-closed: sem ele,
# as rotas respondem 503). Use um valor forte e aleatório com 32+ caracteres,
# ex.: `openssl rand -hex 32`. No Vercel Cron, defina CRON_SECRET no projeto e a
# plataforma injeta `Authorization: Bearer $CRON_SECRET` automaticamente. Em
# self-hosted, agende `curl -H "Authorization: Bearer $CRON_SECRET" \
# https://SEU_HOST/api/internal/cron` (ex.: cron do sistema a cada dia).
CRON_SECRET=""

# Object storage compatível com S3 (AWS S3, Cloudflare R2, MinIO...) para
# avatares/capas. Sem estas variáveis, o app guarda a imagem como data URL
# base64 no banco (fallback). Com elas, a imagem vai para o bucket e o banco
# guarda só a URL pública. Em produção, configure juntas STORAGE_ENDPOINT,
# STORAGE_BUCKET, STORAGE_ACCESS_KEY_ID e STORAGE_SECRET_ACCESS_KEY; o endpoint
# deve usar HTTPS. STORAGE_REGION usa "auto" no R2. STORAGE_PUBLIC_BASE_URL é
# opcional (CDN), mas também deve usar HTTPS; se vazio, usa {endpoint}/{bucket}.
# Depois de configurar, rode
# a migração dos avatares legados: POST /api/internal/migrate-avatars com o
# Authorization: Bearer $CRON_SECRET (em loop até remaining=0).
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# Fonte do conteúdo global (Bíblia/hinário). Padrão (vazio/fs): lê os JSON do
# filesystem. "mongo": lê do banco (um documento por capítulo/hino) com fallback
# ao fs. Fluxo de migração: (1) rode o seed por alvo — POST /api/internal/seed-content
# ?target=ACF ... e ?target=hinos, com Authorization: Bearer $CRON_SECRET; (2) só
# então defina CONTENT_SOURCE=mongo e faça o deploy; (3) confirmado, remova os JSON
# (Versions/, Harpa.json) e o outputFileTracingIncludes do next.config.ts.
CONTENT_SOURCE=""

# Opcional para o app Android; quando definido, deve ser uma origem HTTPS.
CAPACITOR_SERVER_URL=""

# Variáveis temporárias, usadas apenas pelo script de migração inicial.
OWNER_USERNAME=""
OWNER_PASSWORD=""
DRY_RUN="true"
APPLY_MIGRATION="false"
RESET_OWNER_PASSWORD="false"
